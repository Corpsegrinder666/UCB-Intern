@using Microsoft.AspNetCore.Http
@using CIBnext.LIB

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CIB Reporting System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="header">
        <div class="header-left">
            <img src="~/images/logo.jpg" alt="CIB Logo">
            <div class="titles">
                <h1>CIB Next</h1>
                <p>Credit Information Bureau</p>
            </div>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Logout" class="logout-btn">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <path d="M16 17l5-5-5-5" />
                    <path d="M21 12H9" />
                </svg>
                Logout
            </a>
        }
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="info-bar">

            <div class="info-item">
                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
                Reporting Period : <b>@User.FindFirst("ReportingPeriod")?.Value</b>
            </div>

            <div class="info-item">
                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                Role Name : <b>@User.FindFirst("FullName")?.Value</b>
            </div>

            <div class="info-item">
                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <path d="M3 21h18" />
                    <path d="M5 21V7l7-4 7 4v14" />
                    <path d="M9 9h1M14 9h1M9 13h1M14 13h1M9 17h1M14 17h1" />
                </svg>
                Branch : <b>@User.FindFirst("BranchName")?.Value</b>
            </div>

            <div class="info-item">
                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 3" />
                </svg>
                Login Time : <b>@Context.Session.GetString("LoginTime")</b>
            </div>

        </div>
    }

    <div class="wrapper">

        <div class="sidebar" id="sidebar">

            <div class="sidebar-toggle" id="sidebarToggle" title="Collapse / Expand menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 18l-6-6 6-6" />
                </svg>
            </div>

            <div class="sidebar-inner">
                <div class="tree">
                    <ul>

                        <li>
                            <a href="/Home" class="main-link">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                    <path d="M3 9l9-7 9 7" />
                                    <path d="M9 22V12h6v10" />
                                    <path d="M5 10v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V10" />
                                </svg>
                                <span class="label">Home</span>
                            </a>
                        </li>

                        <li>
                            <a href="/Admin" class="main-link">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                    <circle cx="12" cy="8" r="4" />
                                    <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
                                </svg>
                                <span class="label">Admin</span>
                            </a>
                        </li>

                        <li>
                            <span class="toggle open" data-menu-toggle="cib">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                    <path d="M3 21h18" />
                                    <path d="M5 21V7l7-4 7 4v14" />
                                    <path d="M9 9h1M14 9h1M9 13h1M14 13h1M9 17h1M14 17h1" />
                                </svg>
                                <span class="label">CIB</span>
                                <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 18l6-6-6-6" />
                                </svg>
                            </span>

                            <ul id="cib" class="submenu">

                                <li>
                                    <a href="#">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                            <rect x="3" y="3" width="7" height="7" rx="1" />
                                            <rect x="14" y="3" width="7" height="7" rx="1" />
                                            <rect x="3" y="14" width="7" height="7" rx="1" />
                                            <rect x="14" y="14" width="7" height="7" rx="1" />
                                        </svg>
                                        <span class="label">Back Office</span>
                                    </a>
                                </li>

                                @if (User.IsInRoles("2001", "2002", "2003", "ADMIN"))
                                {
                                    <li>
                                        <span class="toggle open" data-menu-toggle="subject">
                                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                                <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" />
                                            </svg>
                                            <span class="label">Subject</span>
                                            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M9 18l6-6-6-6" />
                                            </svg>
                                        </span>

                                        <ul id="subject" class="submenu">

                                            @if (User.IsInRoles("2001", "ADMIN"))
                                            {
                                                <li>
                                                    <a href="/Subject/PersonalInformation">
                                                        <span class="dot"></span>
                                                        <span class="label">Personal Information</span>
                                                    </a>
                                                </li>
                                            }

                                            @if (User.IsInRoles("2002", "ADMIN"))
                                            {
                                                <li>
                                                    <a href="/Subject/InstitutionInformation">
                                                        <span class="dot"></span>
                                                        <span class="label">Institution Information</span>
                                                    </a>
                                                </li>
                                            }

                                            @if (User.IsInRoles("2003", "ADMIN"))
                                            {
                                                <li>
                                                    <a href="/Subject/OwnerLinks">
                                                        <span class="dot"></span>
                                                        <span class="label">Owner Links</span>
                                                    </a>
                                                </li>
                                            }

                                        </ul>
                                    </li>
                                }

                                @if (User.IsInRoles("3001", "3002", "3003", "3004", "3005", "ADMIN"))
                                {
                                    <li>
                                        <span class="toggle open" data-menu-toggle="contract">
                                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                                <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" />
                                            </svg>
                                            <span class="label">Contract</span>
                                            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M9 18l6-6-6-6" />
                                            </svg>
                                        </span>

                                        <ul id="contract" class="submenu">

                                            @if (User.IsInRoles("3001", "ADMIN"))
                                            {
                                                <li>
                                                    <a href="/Contract/InstallmentContract">
                                                        <span class="dot"></span>
                                                        <span class="label">Installment Contract</span>
                                                    </a>
                                                </li>
                                            }

                                            @if (User.IsInRoles("3002", "ADMIN"))
                                            {
                                                <li>
                                                    <a href="/Contract/NonInstallmentContract">
                                                        <span class="dot"></span>
                                                        <span class="label">Non-Installment Contract</span>
                                                    </a>
                                                </li>
                                            }

                                            @if (User.IsInRoles("3004", "ADMIN"))
                                            {
                                                <li>
                                                    <a href="/Contract/ContractLinks">
                                                        <span class="dot"></span>
                                                        <span class="label">Contract Links</span>
                                                    </a>
                                                </li>
                                            }

                                        </ul>
                                    </li>
                                }

                                @if (User.IsInRoles("5001", "5002", "5002", "5003", "ADMIN"))
                                {
                                    <li>
                                        <span class="toggle open" data-menu-toggle="report">
                                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                                <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" />
                                            </svg>
                                            <span class="label">Reports</span>
                                            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M9 18l6-6-6-6" />
                                            </svg>
                                        </span>

                                        <ul id="report" class="submenu">

                                            @if (User.IsInRoles("5001", "ADMIN"))
                                            {
                                                <li>
                                                    <a href="/Reports/ContractsReadyToReport">
                                                        <span class="dot"></span>
                                                        <span class="label">Contracts Ready To Report</span>
                                                    </a>
                                                </li>
                                            }

                                            @if (User.IsInRoles("5002", "ADMIN"))
                                            {
                                                <li>
                                                    <a href="/Reports/ContractsNeedToBeReported">
                                                        <span class="dot"></span>
                                                        <span class="label">Contracts Need To Be Reported</span>
                                                    </a>
                                                </li>
                                            }

                                            @if (User.IsInRoles("5003", "ADMIN"))
                                            {
                                                <li>
                                                    <a href="/Reports/BorrowerWithoutSubjectCode">
                                                        <span class="dot"></span>
                                                        <span class="label">Borrower Without Subject Code</span>
                                                    </a>
                                                </li>
                                            }

                                        </ul>
                                    </li>
                                }

                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </div>

        <div class="content">
            @RenderBody()
        </div>

    </div>

    <div class="footer">
        &copy; @DateTime.Now.Year CIB Reporting System
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>

</body>
</html>
