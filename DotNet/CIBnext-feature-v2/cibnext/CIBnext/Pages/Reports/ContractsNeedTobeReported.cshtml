@page
@model CIBnext.Pages.Reports.ContractsNeedTobeReportedModel

<div class="contracts-need-reported-page">

    <div class="contracts-need-reported-title">
        List of Accounts Need to be Submitted to Bangladesh Bank
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ValidationMessage))
    {
        <div hidden
             data-shared-message="@Model.ValidationMessage"
             data-message-type="warning">
        </div>
    }

    <form method="post" asp-page-handler="Download">
        <div class="contracts-need-reported-section">
            <fieldset>
                <legend>Search Option</legend>

                <label asp-for="BranchCode">Branch</label>

                <select asp-for="BranchCode" asp-items="Model.BranchCodeList">
                    <option value="">All Branch</option>
                </select>

                <button type="submit" class="contracts-need-reported-btn">
                    Download
                </button>
            </fieldset>
        </div>
    </form>

</div>
