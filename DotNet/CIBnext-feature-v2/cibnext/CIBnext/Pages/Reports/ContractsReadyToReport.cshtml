@page
@model CIBnext.Pages.Reports.ContractsReadyToReportModel

<div class="contracts-ready-reported-page">

    <div class="contracts-ready-reported-title">
        List of Ready Error Free Accounts Being Submitted to Bangladesh Bank
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ValidationMessage))
    {
        <div hidden
             data-shared-message="@Model.ValidationMessage"
             data-message-type="warning">
        </div>
    }

    <form method="post" asp-page-handler="Download">
        <div class="contracts-ready-reported-section">
            <fieldset>
                <legend>Search Option</legend>

                <label asp-for="BranchCode">Branch</label>
                <select asp-for="BranchCode" asp-items="Model.BranchCodeList">
                    <option value="">All Branch</option>
                </select>

                <label asp-for="ContractPhase">Contract Phase</label>
                <select asp-for="ContractPhase" asp-items="Model.ContractPhaseList">
                    <option value="">All</option>
                </select>

                <label asp-for="ContractStatus">Contract Status</label>
                <select asp-for="ContractStatus" asp-items="Model.ContractStatusList">
                    <option value="">All</option>
                </select>

                <button type="submit" class="contracts-ready-reported-btn">
                    Download
                </button>
            </fieldset>
        </div>
    </form>

</div>
