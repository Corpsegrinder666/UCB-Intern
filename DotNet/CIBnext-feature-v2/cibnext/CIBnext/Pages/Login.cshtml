@page
@model CIBnext.Pages.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - CIB Reporting System</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">

    <div class="top-header">
        <img src="~/images/logo.jpg" alt="CIB Logo" />
        <div>
            <h1>CIB Next</h1>
            <p>Credit Information Bureau</p>
        </div>
    </div>

    <div class="content">
        <div class="bg-sweep"></div>

        <div class="brand-panel">
            <img src="~/images/logo.jpg" alt="CIB Logo" />
            <h2>CIB</h2>
            <div class="sub">Reporting System</div>
            <div class="tagline">Secure. Reliable. Trusted.</div>
        </div>

        <div class="login-box">
            <div class="logo-circle">
                <img src="~/images/logo.jpg" alt="CIB Logo" />
            </div>

            <p class="welcome">Welcome Back!</p>
            <h3>Log in to your account</h3>
            <p class="hint">Please enter your credentials to continue</p>
            <div class="divider"></div>

            <form method="post">
                <div class="field">
                    <label asp-for="UserName">AD ID</label>

                    <div class="input-wrap">
                        <svg width="18" height="18"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="#9ca3af"
                             stroke-width="2"
                             aria-hidden="true">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>

                        <input asp-for="UserName"
                               placeholder="Enter AD ID"
                               autocomplete="username" />
                    </div>
                </div>

                <div class="field">
                    <label asp-for="Password">Password</label>

                    <div class="input-wrap">
                        <svg width="18" height="18"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="#9ca3af"
                             stroke-width="2"
                             aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>

                        <input asp-for="Password"
                               type="password"
                               placeholder="Enter Password"
                               autocomplete="current-password" />
                    </div>
                </div>

                <button type="submit" class="login-btn">
                    <svg width="18" height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="#fff"
                         stroke-width="2"
                         aria-hidden="true">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        <path d="M10 17l5-5-5-5" />
                        <path d="M15 12H3" />
                    </svg>

                    Login to System
                </button>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <p class="error" role="alert">@Model.ErrorMessage</p>
                }
            </form>

            <div class="foot-note">
                Need help? Contact
                <a href="#">System Administrator</a>
            </div>
        </div>
    </div>

    <div class="site-footer">
        &copy; @DateTime.Now.Year Credit Information Bureau (CIB).
        All rights reserved.
    </div>

</body>
</html>
