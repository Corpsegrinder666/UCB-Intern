@page
@model CIBnext.Pages.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - CIB Reporting System</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Arial, sans-serif;
                background: #f4f6f9;
                margin: 0;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            
            .top-header {
                background: linear-gradient(90deg, #C40F1E 0%, #8f0b16 100%);
                padding: 22px 40px;
                display: flex;
                align-items: center;
                gap: 16px;
            }

                .top-header img {
                    width: 46px;
                    height: 46px;
                    background: #fff;
                    border-radius: 8px;
                    padding: 4px;
                    object-fit: contain;
                }

                .top-header h1 {
                    color: #fff;
                    font-size: 22px;
                    margin: 0;
                    letter-spacing: .5px;
                }

                .top-header p {
                    color: #ffe1e1;
                    margin: 0;
                    font-size: 13px;
                }

            
            .content {
                flex: 1;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                padding: 60px 20px;
            }

            
            .bg-image {
                position: absolute;
                left: 0;
                bottom: 0;
                width: 46%;
                max-width: 560px;
                opacity: 0.06;
                pointer-events: none;
                user-select: none;
            }

            
            .bg-sweep {
                position: absolute;
                left: -10%;
                bottom: -18%;
                width: 60%;
                height: 55%;
                background: linear-gradient(135deg, #E31B23, #8f0b16);
                border-radius: 50%;
                opacity: .95;
                filter: blur(0px);
                clip-path: ellipse(60% 55% at 30% 70%);
                z-index: 0;
            }

            .brand-panel {
                position: relative;
                z-index: 1;
                flex: 1;
                max-width: 420px;
                padding: 0 40px;
                display: flex;
                flex-direction: column;
                align-items: flex-start;
            }

                .brand-panel img {
                    width: 70px;
                    margin-bottom: 14px;
                }

                .brand-panel h2 {
                    font-size: 32px;
                    margin: 0;
                    color: #17202a;
                    line-height: 1.15;
                }

                .brand-panel .sub {
                    font-size: 14px;
                    letter-spacing: 3px;
                    color: #6b7280;
                    margin: 4px 0 18px;
                    text-transform: uppercase;
                }

                .brand-panel .tagline {
                    font-size: 15px;
                    color: #374151;
                    border-bottom: 3px solid #E31B23;
                    padding-bottom: 10px;
                    display: inline-block;
                }

           
            .login-box {
                position: relative;
                z-index: 1;
                width: 100%;
                max-width: 430px;
                background: #fff;
                padding: 44px 46px;
                border-radius: 14px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.08);
                text-align: center;
            }

            .logo-circle {
                width: 92px;
                height: 92px;
                border-radius: 50%;
                background: #fdecec;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 18px;
            }

                .logo-circle img {
                    width: 48px;
                    height: 48px;
                    object-fit: contain;
                }

            .login-box .welcome {
                color: #E31B23;
                font-weight: 600;
                margin: 0 0 4px;
            }

            .login-box h3 {
                margin: 0 0 6px;
                font-size: 24px;
                color: #17202a;
            }

            .login-box .hint {
                color: #6b7280;
                font-size: 13.5px;
                margin: 0 0 18px;
            }

            .divider {
                width: 60px;
                height: 3px;
                background: #E31B23;
                margin: 0 auto 22px;
                border-radius: 2px;
            }

            .field {
                text-align: left;
                margin-bottom: 16px;
            }

                .field label {
                    display: block;
                    font-size: 13.5px;
                    font-weight: 600;
                    color: #374151;
                    margin-bottom: 6px;
                }

            .input-wrap {
                position: relative;
                display: flex;
                align-items: center;
                border: 1px solid #e2e5ea;
                border-radius: 8px;
                background: #fafbfc;
                padding: 0 12px;
            }

                .input-wrap svg {
                    flex-shrink: 0;
                    margin-right: 8px;
                }

                .input-wrap input {
                    border: none;
                    background: transparent;
                    outline: none;
                    width: 100%;
                    padding: 12px 4px;
                    font-size: 14px;
                }

            .login-btn {
                margin-top: 8px;
                width: 100%;
                padding: 13px;
                background: linear-gradient(90deg, #E31B23, #b5141b);
                color: #fff;
                border: none;
                border-radius: 8px;
                font-size: 15.5px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

                .login-btn:hover {
                    opacity: .92;
                }

            .foot-note {
                margin-top: 22px;
                padding-top: 18px;
                border-top: 1px solid #eee;
                font-size: 13px;
                color: #6b7280;
            }

                .foot-note a {
                    color: #E31B23;
                    font-weight: 600;
                    text-decoration: none;
                }

            .error {
                color: #E31B23;
                background: #fdecec;
                border: 1px solid #f7c6c6;
                padding: 10px 12px;
                border-radius: 8px;
                margin-top: 16px;
                font-size: 13.5px;
            }

            .site-footer {
                text-align: center;
                color: #9ca3af;
                font-size: 12.5px;
                padding: 16px;
            }

            @@media (max-width: 900px) {
                .brand-panel {
                    display: none;
                }
            }
    </style>
</head>
<body>

    <div class="top-header">
        <img src="./images/logo.jpg">
        <div>
            <h1>CIB Next</h1>
            <p>Credit Information Bureau</p>
        </div>
    </div>

    <div class="content">
        <div class="bg-sweep"></div>

        <div class="brand-panel">
            <img src="~/images/logo.jpg">
            <h2>CIB</h2>
            <div class="sub">Reporting System</div>
            <div class="tagline">Secure. Reliable. Trusted.</div>
        </div>

        <div class="login-box">
            <div class="logo-circle">
                <img src="./images/logo.jpg">
            </div>

            <p class="welcome">Welcome Back!</p>
            <h3>Log in to your account</h3>
            <p class="hint">Please enter your credentials to continue</p>
            <div class="divider"></div>

            <form method="post">

                <div class="field">
                    <label>AD ID</label>
                    <div class="input-wrap">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        <input asp-for="UserName" placeholder="Enter AD ID" />
                    </div>
                </div>

                <div class="field">
                    <label>Password</label>
                    <div class="input-wrap">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        <input asp-for="Password" type="password" placeholder="Enter Password" />
                    </div>
                </div>

                <button type="submit" class="login-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><path d="M10 17l5-5-5-5" /><path d="M15 12H3" /></svg>
                    Login to System
                </button>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <p class="error">@Model.ErrorMessage</p>
                }

            </form>

            <div class="foot-note">
                Need help? Contact <a href="#">System Administrator</a>
            </div>
        </div>
    </div>

    <div class="site-footer">
        &copy; @DateTime.Now.Year Credit Information Bureau (CIB). All rights reserved.
    </div>

</body>
</html>
