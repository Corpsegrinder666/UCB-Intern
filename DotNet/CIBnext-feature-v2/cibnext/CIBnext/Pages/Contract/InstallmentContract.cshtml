@page
@model CIBnext.Pages.Contract.InstalmentContractModel

<div class="installment-contract-page">

    <div class="page-title">Installment Contract List</div>

    <form method="get" id="searchForm">
        <input type="hidden" name="SearchSubmitted" value="true" />
        <input type="hidden" name="PageIndex" value="1" />

        <div class="section">
            <fieldset>
                <legend>Search Option</legend>

                <table class="installment-search-table">
                    <tr>
                        <td>Branch Code:</td>
                        <td>
                            <select asp-for="BranchCode"
                                    asp-items="Model.BranchCodeList">
                                <option value="">All Branch</option>
                            </select>
                        </td>

                        <td>Contract Code:</td>
                        <td>
                            <input asp-for="ContractCode" />
                        </td>

                        <td>F.I. Subject Code:</td>
                        <td>
                            <input asp-for="FISubjectCode" />
                        </td>

                        <td>Contract Phase</td>
                        <td>
                            <select asp-for="ContractPhase"
                                    asp-items="Model.ContractPhaseList">
                                <option value="">--Select--</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td>UBS A/C No:</td>
                        <td>
                            <input asp-for="UbsAcNo" />
                        </td>
                    </tr>
                </table>

                <button type="submit" class="btn-small">
                    Search
                </button>

                <a href="/Contract/InstallmentContract"
                   class="btn-small">
                    Clear
                </a>

                <a asp-page="/Contract/InstallmentContractErrorList">
                    Go to Error List
                </a>
            </fieldset>
        </div>
    </form>

    <div class="section">
        <fieldset>
            <legend>Installment Contract Information</legend>

            @if (Model.SearchSubmitted)
            {
                <h3>Total Count: @Model.TotalCount</h3>
            }

            <form method="post"
                  asp-page-handler="Delete"
                  id="deleteContractsForm">

                @if (Model.SearchSubmitted)
                {
                    <input type="hidden" asp-for="BranchCode" />
                    <input type="hidden" asp-for="ContractCode" />
                    <input type="hidden" asp-for="FISubjectCode" />
                    <input type="hidden" asp-for="ContractPhase" />
                    <input type="hidden" asp-for="UbsAcNo" />

                    <input type="hidden" asp-for="PageIndex" />
                    <input type="hidden" asp-for="SearchSubmitted" />

                    <table>
                        <tr>
                            <th></th>
                            <th>Action</th>
                            <th>Branch Code</th>
                            <th>Subject Code</th>
                            <th>Borrower Name</th>
                            <th>Contract Code</th>
                            <th>Contract Type</th>
                            <th>Contract Phase</th>
                            <th>Contract Status</th>
                            <th>Currency Code</th>
                            <th>Sanction Limit</th>
                        </tr>

                        @if (Model.ContractList != null &&
                             Model.ContractList.Any())
                        {
                            @foreach (var c in Model.ContractList)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               name="SelectedCodes"
                                               value="@c.FIContractCode" />
                                    </td>

                                    <td>
                                        <a href="/Contract/AddInstalmentContract?contractCode=@Uri.EscapeDataString(c.FIContractCode ?? "")">
                                            View/Edit
                                        </a>
                                    </td>

                                    <td>@c.BranchCode</td>
                                    <td>@c.FISubjectCode</td>
                                    <td>@c.BorrowerName</td>
                                    <td>@c.FIContractCode</td>
                                    <td>@c.ContractType</td>
                                    <td>@c.ContractPhase</td>
                                    <td>@c.ContractStatus</td>
                                    <td>@c.CurrencyCode</td>
                                    <td>@c.SanctionLimit</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="installment-empty-row">
                                    No records found
                                </td>
                            </tr>
                        }
                    </table>

                    @if (Model.TotalCount > 0)
                    {
                        <div class="pagination installment-pagination">

                            @if (Model.PageIndex > 1)
                            {
                                <a href="/Contract/InstallmentContract?PageIndex=@(Model.PageIndex - 1)&SearchSubmitted=true&BranchCode=@Uri.EscapeDataString(Model.BranchCode ?? "")&ContractCode=@Uri.EscapeDataString(Model.ContractCode ?? "")&FISubjectCode=@Uri.EscapeDataString(Model.FISubjectCode ?? "")&ContractPhase=@Uri.EscapeDataString(Model.ContractPhase ?? "")&UbsAcNo=@Uri.EscapeDataString(Model.UbsAcNo ?? "")">
                                    Previous
                                </a>
                            }

                            @{
                                var lastDisplayedPage = 0;
                            }

                            @for (int pageNumber = 1;
                                  pageNumber <= Model.TotalPages;
                                  pageNumber++)
                            {
                                var displayPage =
                                    Model.TotalPages <= 7
                                    || pageNumber <= 3
                                    || pageNumber > Model.TotalPages - 3
                                    || Math.Abs(pageNumber - Model.PageIndex) <= 2;

                                if (!displayPage)
                                {
                                    continue;
                                }

                                if (lastDisplayedPage > 0 &&
                                    pageNumber > lastDisplayedPage + 1)
                                {
                                    <span class="ellipsis">...</span>
                                }

                                if (pageNumber == Model.PageIndex)
                                {
                                    <span class="current">@pageNumber</span>
                                }
                                else
                                {
                                    <a href="/Contract/InstallmentContract?PageIndex=@pageNumber&SearchSubmitted=true&BranchCode=@Uri.EscapeDataString(Model.BranchCode ?? "")&ContractCode=@Uri.EscapeDataString(Model.ContractCode ?? "")&FISubjectCode=@Uri.EscapeDataString(Model.FISubjectCode ?? "")&ContractPhase=@Uri.EscapeDataString(Model.ContractPhase ?? "")&UbsAcNo=@Uri.EscapeDataString(Model.UbsAcNo ?? "")">
                                        @pageNumber
                                    </a>
                                }

                                lastDisplayedPage = pageNumber;
                            }

                            @if (Model.PageIndex < Model.TotalPages)
                            {
                                <a href="/Contract/InstallmentContract?PageIndex=@(Model.PageIndex + 1)&SearchSubmitted=true&BranchCode=@Uri.EscapeDataString(Model.BranchCode ?? "")&ContractCode=@Uri.EscapeDataString(Model.ContractCode ?? "")&FISubjectCode=@Uri.EscapeDataString(Model.FISubjectCode ?? "")&ContractPhase=@Uri.EscapeDataString(Model.ContractPhase ?? "")&UbsAcNo=@Uri.EscapeDataString(Model.UbsAcNo ?? "")">
                                    Next
                                </a>
                            }

                        </div>
                    }
                }

                <br />

                <a href="/Contract/AddInstalmentContract"
                   class="btn-small">
                    Add
                </a>

                @if (Model.SearchSubmitted)
                {
                    <button class="btn-small"
                            type="button"
                            data-installment-refresh>
                        Refresh
                    </button>

                    <button type="button"
                            class="btn-small"
                            data-installment-delete-open>
                        Delete
                    </button>
                }

            </form>
        </fieldset>
    </div>

    @* Delete message popup *@
    @if (!string.IsNullOrWhiteSpace(Model.DeleteMessage))
    {
        <div id="messageModal"
             class="message-overlay"
             role="dialog"
             aria-modal="true"
             aria-labelledby="messageModalTitle">

            <div class="message-dialog">
                <div class="message-header @Model.DeleteMessageType">
                    <h3 id="messageModalTitle">@Model.DeleteMessageTitle</h3>
                    <button type="button"
                            class="message-close"
                            aria-label="Close message">
                        &times;
                    </button>
                </div>

                <div class="message-body @Model.DeleteMessageType">
                    @Model.DeleteMessage
                </div>

                <div class="message-footer">
                    <button type="button"
                            class="message-button @Model.DeleteMessageType">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div id="messageModal"
             class="message-overlay"
             role="dialog"
             aria-modal="true"
             aria-labelledby="messageModalTitle">

            <div class="message-dialog">
                <div class="message-header success">
                    <h3 id="messageModalTitle">Success</h3>
                    <button type="button"
                            class="message-close"
                            aria-label="Close message">
                        &times;
                    </button>
                </div>

                <div class="message-body success">
                    @Model.SuccessMessage
                </div>

                <div class="message-footer">
                    <button type="button" class="message-button success">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }

    @* Separate delete confirmation; it does not auto-dismiss. *@
    <div id="deleteConfirmModal"
         class="message-overlay hidden"
         role="dialog"
         aria-modal="true"
         aria-labelledby="deleteConfirmTitle"
         aria-hidden="true">

        <div class="message-dialog">
            <div class="message-header warning">
                <h3 id="deleteConfirmTitle">Confirm deletion</h3>
                <button type="button"
                        class="message-close"
                        aria-label="Close delete confirmation"
                        data-delete-cancel>
                    &times;
                </button>
            </div>

            <div class="message-body warning">
                Are you sure you want to delete the selected contract record(s)?
                This action may not be reversible.
            </div>

            <div class="message-footer">
                <button type="button"
                        class="message-button confirm-cancel">
                    Cancel
                </button>

                <button type="button"
                        class="message-button"
                        data-installment-delete-confirm>
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>

</div>
