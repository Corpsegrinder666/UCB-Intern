@page
@model CIBnext.Pages.Contract.ContractLinksModel

@{
    var popupType = "info";
    var popupTitle = "Information";
    var popupMessage = string.Empty;
    var showPopup = false;

    if (!string.IsNullOrEmpty(Model.DeleteMessage))
    {
        popupType = Model.DeleteMessageType ?? "info";
        popupTitle = Model.DeleteMessageTitle ?? "Delete";
        popupMessage = Model.DeleteMessage;
        showPopup = true;
    }
    else if (!string.IsNullOrEmpty(Model.ValidationMessage))
    {
        popupType = Model.ValidationMessageType ?? "warning";
        popupTitle = Model.ValidationMessageTitle ?? "Validation";
        popupMessage = Model.ValidationMessage;
        showPopup = true;
    }
    else if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        popupType = "success";
        popupTitle = "Success";
        popupMessage = Model.SuccessMessage;
        showPopup = true;
    }
}

<div class="contract-links-page">

    <div class="page-title">Contract Link List</div>

    <form method="get">
        <div class="section">
            <fieldset>
                <legend>Search Option</legend>

                <table class="contract-links-search-table">
                    <tr>
                        <td>Branch Code:</td>
                        <td>
                            <select asp-for="SearchBranchCode"
                                    asp-items="Model.BranchCodeList">
                                <option value="">--Select--</option>
                            </select>
                        </td>

                        <td>Primary Sub. Code:</td>
                        <td>
                            <input asp-for="SearchPrimaryCode" />
                        </td>

                        <td>Primary Sub. Name:</td>
                        <td>
                            <input asp-for="SearchPrimaryName" />
                        </td>

                        <td>Secondary Sub. Code:</td>
                        <td>
                            <input asp-for="SearchSecondaryCode" />
                        </td>
                    </tr>

                    <tr>
                        <td>Secondary Sub. Name:</td>
                        <td>
                            <input asp-for="SearchSecondaryName" />
                        </td>

                        <td>Contract Code:</td>
                        <td>
                            <input asp-for="SearchContractCode" />
                        </td>
                    </tr>
                </table>

                <button type="submit" class="btn-small">Search</button>
                <a href="/Contract/ContractLinks" class="btn-small">Clear</a>
            </fieldset>
        </div>
    </form>

    <form method="post" asp-page-handler="Save">
        <div class="section">
            <fieldset id="add-edit-fieldset">
                <legend>
                    @(Model.IsEdit ? "Edit Contract Link" : "Add Contract Link")
                </legend>

                @if (Model.IsEdit)
                {
                    <input type="hidden" asp-for="EditContract" />
                    <input type="hidden" asp-for="EditSecondary" />
                }

                <div class="form-row">
                    <label class="label-hint">Branch</label>
                    <select asp-for="AddLink.BranchCode"
                            asp-items="Model.BranchNameList">
                        <option value="">--Select--</option>
                    </select>
                </div>

                <div class="form-row">
                    <label>Type of Link</label>
                    <select asp-for="AddLink.TypeOfLink"
                            asp-items="Model.LinkTypeList">
                        <option value="">--Select--</option>
                    </select>
                </div>

                <div class="form-row">
                    <label class="label-hint">F.I. Contract Code</label>

                    @if (Model.IsEdit)
                    {
                        <input asp-for="AddLink.FIContractCode" readonly />
                    }
                    else
                    {
                        <input asp-for="AddLink.FIContractCode"
                               id="fiContractCode"
                               data-primary-code-lookup-url="@Url.Page("/Contract/ContractLinks", "LookupPrimaryCode")" />
                    }
                </div>

                <div class="form-row">
                    <label class="label-hint">F.I. Primary Code</label>
                    <input asp-for="AddLink.FIPrimaryCode"
                           id="fiPrimaryCode"
                           readonly />
                </div>

                <div class="form-row">
                    <label class="label-hint">F.I. Secondary Code</label>

                    @if (Model.IsEdit)
                    {
                        <input asp-for="AddLink.FISecondaryCode" readonly />
                    }
                    else
                    {
                        <input asp-for="AddLink.FISecondaryCode" />
                    }
                </div>

                <button type="submit" class="btn-small">
                    @(Model.IsEdit ? "Update" : "Save")
                </button>

                @if (Model.IsEdit)
                {
                    <a href="/Contract/ContractLinks" class="btn-small">
                        Cancel Edit
                    </a>
                }
            </fieldset>
        </div>
    </form>

    <div class="section">
        <fieldset>
            <legend>Contract Link Information</legend>

            <h3>Total Count: @Model.TotalCount</h3>

            <form method="post"
                  asp-page-handler="Delete"
                  id="deleteLinksForm">

                <table>
                    <tr>
                        <th></th>
                        <th>Action</th>
                        <th>Branch Code</th>
                        <th>Type</th>
                        <th>Primary Sub. Code</th>
                        <th>Primary Sub. Name</th>
                        <th>Secondary Sub. Code</th>
                        <th>Secondary Sub. Name</th>
                        <th>Contract Code</th>
                    </tr>

                    @if (Model.LinkList != null && Model.LinkList.Any())
                    {
                        @foreach (var link in Model.LinkList)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox"
                                           name="SelectedLinks"
                                           value="@(link.FIContractCode)|@(link.FISecondaryCode)" />
                                </td>

                                <td>
                                    <a href="/Contract/ContractLinks?EditContract=@Uri.EscapeDataString(link.FIContractCode)&EditSecondary=@Uri.EscapeDataString(link.FISecondaryCode ?? "")">
                                        Edit
                                    </a>
                                </td>

                                <td>@link.BranchCode</td>
                                <td>@link.TypeOfLink</td>
                                <td>@link.FIPrimaryCode</td>
                                <td>@link.FIPrimaryName</td>
                                <td>@link.FISecondaryCode</td>
                                <td>@link.FISecondaryName</td>
                                <td>@link.FIContractCode</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="contract-links-empty-row">
                                No records found
                            </td>
                        </tr>
                    }
                </table>

                <div class="pagination contract-links-pagination">
                    @{
                        var lastDisplayedPage = 0;
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        var displayPage = i <= 3
                            || i > Model.TotalPages - 3
                            || Math.Abs(i - Model.PageIndex) <= 2;

                        if (!displayPage)
                        {
                            continue;
                        }

                        if (lastDisplayedPage > 0 && i > lastDisplayedPage + 1)
                        {
                            <span class="ellipsis">...</span>
                        }

                        if (i == Model.PageIndex)
                        {
                            <span class="current">@i</span>
                        }
                        else
                        {
                            <a href="/Contract/ContractLinks?PageIndex=@i&SearchBranchCode=@Model.SearchBranchCode&SearchPrimaryCode=@Model.SearchPrimaryCode&SearchPrimaryName=@Model.SearchPrimaryName&SearchSecondaryCode=@Model.SearchSecondaryCode&SearchSecondaryName=@Model.SearchSecondaryName&SearchContractCode=@Model.SearchContractCode">
                                @i
                            </a>
                        }

                        lastDisplayedPage = i;
                    }
                </div>

                <br />

                <a href="/Contract/ContractLinks" class="btn-small">Add</a>

                <button class="btn-small"
                        data-contract-links-refresh
                        type="button">
                    Refresh
                </button>

                <button type="button"
                        class="btn-small"
                        data-contract-links-delete-open>
                    Delete
                </button>
            </form>
        </fieldset>
    </div>

    @if (showPopup)
    {
        <div id="messageModal"
             class="message-overlay contract-links-popup"
             role="dialog"
             aria-modal="true">

            <div class="message-dialog">
                <div class="message-header @popupType">
                    <h3>@popupTitle</h3>

                    <button type="button"
                            class="message-close"
                            aria-label="Close">
                        &times;
                    </button>
                </div>

                <div class="message-body @popupType">
                    @Html.Raw(popupMessage)
                </div>

                <div class="message-footer">
                    <button type="button" class="message-ok">OK</button>
                </div>
            </div>
        </div>
    }

    <div id="deleteConfirmModal"
         class="message-overlay contract-links-delete-modal"
         role="dialog"
         aria-modal="true">

        <div class="message-dialog">
            <div class="message-header warning">
                <h3>Confirm Delete</h3>
            </div>

            <div class="message-body warning">
                Are you sure you want to delete the selected record(s)?
            </div>

            <div class="message-footer">
                <button type="button"
                        class="message-button"
                        data-contract-links-delete-confirm>
                    Yes, Delete
                </button>

                <button type="button"
                        class="message-button confirm-cancel">
                    Cancel
                </button>
            </div>
        </div>
    </div>

</div>
