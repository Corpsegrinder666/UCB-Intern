@page
@model CIBnext.Pages.Contract.NonInstallmentContractModel

<div class="non-installment-contract-page">

    <div class="page-title">Non Installment Contract List</div>

    <form method="get" id="searchForm">
        <div class="section">
            <fieldset>
                <legend>Search Option</legend>

                <table class="non-installment-search-table">
                    <tr>
                        <td>Branch Code:</td>
                        <td>
                            <select asp-for="BranchCode"
                                    asp-items="Model.BranchCodeList">
                                <option value="">All Branch</option>
                            </select>
                        </td>

                        <td>Contract Code:</td>
                        <td>
                            <input asp-for="ContractCode" />
                        </td>

                        <td>F.I. Subject Code:</td>
                        <td>
                            <input asp-for="FISubjectCode" />
                        </td>

                        <td>Contract Phase</td>
                        <td>
                            <select asp-for="ContractPhase"
                                    asp-items="Model.ContractPhaseList">
                                <option value="">--Select--</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td>UBS Account No:</td>
                        <td>
                            <input asp-for="UbsAcNo" />
                        </td>
                    </tr>
                </table>

                <button type="submit"
                        class="btn-small"
                        name="SearchSubmitted"
                        value="true">
                    Search
                </button>

                <a href="/Contract/NonInstallmentContract"
                   class="btn-small">
                    Clear
                </a>

                <a href="#">Go to Error List</a>
            </fieldset>
        </div>
    </form>

    <div class="section">
        <fieldset>
            <legend>Non Installment Contract Information</legend>

            <h3>Total Count: @Model.TotalCount</h3>

            <form method="post"
                  asp-page-handler="Delete"
                  id="deleteContractsForm">

                <table>
                    <tr>
                        <th></th>
                        <th>Action</th>
                        <th>Branch</th>
                        <th>Subject Code</th>
                        <th>Borrower Name</th>
                        <th>Contract Code</th>
                        <th>Contract Type</th>
                        <th>Contract Phase</th>
                        <th>Contract Status</th>
                        <th>Currency</th>
                        <th>Sanction Limit</th>
                    </tr>

                    @if (Model.ContractList != null && Model.ContractList.Any())
                    {
                        @foreach (var c in Model.ContractList)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox"
                                           name="SelectedCodes"
                                           value="@c.FIContractCode" />
                                </td>

                                <td>
                                    <a href="/Contract/AddNonInstallmentContract?contractCode=@c.FIContractCode">
                                        View/Edit
                                    </a>
                                </td>

                                <td>@c.BranchCode</td>
                                <td>@c.FISubjectCode</td>
                                <td>@c.BorrowerName</td>
                                <td>@c.FIContractCode</td>
                                <td>@c.ContractType</td>
                                <td>@c.ContractPhase</td>
                                <td>@c.ContractStatus</td>
                                <td>@c.CurrencyCode</td>
                                <td>@c.SanctionLimit</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="non-installment-empty-row">
                                No records found
                            </td>
                        </tr>
                    }
                </table>

                <div class="pagination non-installment-pagination">
                    @{
                        var lastDisplayedPage = 0;
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        var displayPage =
                            i <= 3 ||
                            i > Model.TotalPages - 3 ||
                            Math.Abs(i - Model.PageIndex) <= 2;

                        if (!displayPage)
                        {
                            continue;
                        }

                        if (lastDisplayedPage > 0 && i > lastDisplayedPage + 1)
                        {
                            <span class="ellipsis">...</span>
                        }

                        if (i == Model.PageIndex)
                        {
                            <span class="current">@i</span>
                        }
                        else
                        {
                            <a href="/Contract/NonInstallmentContract?PageIndex=@i&BranchCode=@Model.BranchCode&ContractCode=@Model.ContractCode&FISubjectCode=@Model.FISubjectCode&ContractPhase=@Model.ContractPhase&UbsAcNo=@Model.UbsAcNo">
                                @i
                            </a>
                        }

                        lastDisplayedPage = i;
                    }
                </div>

                <br />

                <a href="/Contract/AddNonInstallmentContract"
                   class="btn-small">
                    Add
                </a>

                <button class="btn-small"
                        data-noninstallment-refresh
                        type="button">
                    Refresh
                </button>

                <button type="submit"
                        class="btn-small"
                        id="deleteContractsButton">
                    Delete
                </button>
            </form>
        </fieldset>
    </div>

    @{
        var popupMessage = Model.DeleteMessage;
        var popupTitle = Model.DeleteMessageTitle;
        var popupType = Model.DeleteMessageType;

        if (string.IsNullOrWhiteSpace(popupMessage) &&
            !string.IsNullOrWhiteSpace(Model.SearchMessage))
        {
            popupMessage = Model.SearchMessage;
            popupTitle = "Search";
            popupType = "warning";
        }
        else if (string.IsNullOrWhiteSpace(popupMessage) &&
                 !string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            popupMessage = Model.SuccessMessage;
            popupTitle = "Success";
            popupType = "success";
        }
    }

    @if (!string.IsNullOrWhiteSpace(popupMessage))
    {
        <div class="message-overlay"
             id="messageModal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="messageTitle"
             aria-describedby="messageBody">

            <div class="message-dialog">
                <div class="message-header @popupType">
                    <h3 id="messageTitle">@popupTitle</h3>
                    <button type="button"
                            class="message-close"
                            aria-label="Close">
                        &times;
                    </button>
                </div>

                <div class="message-body @popupType" id="messageBody">
                    @popupMessage
                </div>

                <div class="message-footer">
                    <button type="button" class="message-ok">OK</button>
                </div>
            </div>
        </div>
    }

    <!-- Separate delete confirmation dialog -->
    <div class="message-overlay"
         id="deleteConfirmModal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="deleteConfirmTitle"
         aria-describedby="deleteConfirmBody"
         style="display:none;">

        <div class="message-dialog">
            <div class="message-header warning">
                <h3 id="deleteConfirmTitle">Confirm Deletion</h3>
            </div>

            <div class="message-body warning" id="deleteConfirmBody">
                Are you sure you want to delete the selected contract(s)?
            </div>

            <div class="message-footer">
                <button type="button"
                        class="message-button"
                        id="confirmDeleteButton">
                    Yes, Delete
                </button>

                <button type="button"
                        class="message-ok"
                        id="cancelDeleteButton">
                    Cancel
                </button>
            </div>
        </div>
    </div>

</div>