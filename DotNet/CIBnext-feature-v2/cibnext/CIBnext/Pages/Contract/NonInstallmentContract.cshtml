@page
@model CIBnext.Pages.Contract.NonInstallmentContractModel

<div class="non-installment-contract-page">

    <div class="page-title">Non Installment Contract List</div>

    <form method="get" id="searchForm">
        <div class="section">
            <fieldset>
                <legend>Search Option</legend>

                <input type="hidden"
                       name="SearchSubmitted"
                       value="true" />

                <input type="hidden"
                       name="PageIndex"
                       value="1" />

                <table class="non-installment-search-table">
                    <tr>
                        <td>Branch Code:</td>
                        <td>
                            <select asp-for="BranchCode"
                                    asp-items="Model.BranchCodeList">
                                <option value="">All Branch</option>
                            </select>
                        </td>

                        <td>Contract Code:</td>
                        <td>
                            <input asp-for="ContractCode" />
                        </td>

                        <td>F.I. Subject Code:</td>
                        <td>
                            <input asp-for="FISubjectCode" />
                        </td>

                        <td>Contract Phase</td>
                        <td>
                            <select asp-for="ContractPhase"
                                    asp-items="Model.ContractPhaseList">
                                <option value="">--Select--</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td>UBS Account No:</td>
                        <td>
                            <input asp-for="UbsAcNo" />
                        </td>
                    </tr>
                </table>

                <button type="submit" class="btn-small">
                    Search
                </button>

                <a href="/Contract/NonInstallmentContract"
                   class="btn-small">
                    Clear
                </a>

                <a asp-page="/Contract/NonInstallmentContractErrorList"
                   asp-route-BranchCode="@Model.BranchCode"
                   asp-route-ContractCode="@Model.ContractCode"
                   asp-route-FISubjectCode="@Model.FISubjectCode"
                   asp-route-ContractPhase="@Model.ContractPhase"
                   asp-route-UbsAcNo="@Model.UbsAcNo">
                    Go to Error List
                </a>
            </fieldset>
        </div>
    </form>

    <div class="section">
        <fieldset>
            <legend>Non Installment Contract Information</legend>

            @if (Model.SearchSubmitted)
            {
                <h3>Total Count: @Model.TotalCount</h3>
            }

            <form method="post"
                  asp-page-handler="Delete"
                  id="deleteContractsForm">

                @if (Model.SearchSubmitted)
                {
                    <input type="hidden"
                           name="PageIndex"
                           value="@Model.PageIndex" />

                    <input type="hidden"
                           name="SearchSubmitted"
                           value="true" />

                    <input type="hidden"
                           name="BranchCode"
                           value="@Model.BranchCode" />

                    <input type="hidden"
                           name="ContractCode"
                           value="@Model.ContractCode" />

                    <input type="hidden"
                           name="FISubjectCode"
                           value="@Model.FISubjectCode" />

                    <input type="hidden"
                           name="ContractPhase"
                           value="@Model.ContractPhase" />

                    <input type="hidden"
                           name="UbsAcNo"
                           value="@Model.UbsAcNo" />

                    <table>
                        <tr>
                            <th></th>
                            <th>Action</th>
                            <th>Branch</th>
                            <th>Subject Code</th>
                            <th>Borrower Name</th>
                            <th>Contract Code</th>
                            <th>Contract Type</th>
                            <th>Contract Phase</th>
                            <th>Contract Status</th>
                            <th>Currency</th>
                            <th>Sanction Limit</th>
                        </tr>

                        @if (Model.ContractList != null &&
                             Model.ContractList.Any())
                        {
                            @foreach (var c in Model.ContractList)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               name="SelectedCodes"
                                               value="@c.FIContractCode" />
                                    </td>

                                    <td>
                                        <a href="/Contract/AddNonInstallmentContract?contractCode=@Uri.EscapeDataString(c.FIContractCode ?? "")">
                                            View/Edit
                                        </a>
                                    </td>

                                    <td>@c.BranchCode</td>
                                    <td>@c.FISubjectCode</td>
                                    <td>@c.BorrowerName</td>
                                    <td>@c.FIContractCode</td>
                                    <td>@c.ContractType</td>
                                    <td>@c.ContractPhase</td>
                                    <td>@c.ContractStatus</td>
                                    <td>@c.CurrencyCode</td>
                                    <td>@c.SanctionLimit</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11"
                                    class="non-installment-empty-row">
                                    No records found
                                </td>
                            </tr>
                        }
                    </table>

                    @if (Model.TotalCount > 0)
                    {
                        <div class="pagination non-installment-pagination">

                            @if (Model.PageIndex > 1)
                            {
                                <a href="/Contract/NonInstallmentContract?PageIndex=@(Model.PageIndex - 1)&SearchSubmitted=true&BranchCode=@Uri.EscapeDataString(Model.BranchCode ?? "")&ContractCode=@Uri.EscapeDataString(Model.ContractCode ?? "")&FISubjectCode=@Uri.EscapeDataString(Model.FISubjectCode ?? "")&ContractPhase=@Uri.EscapeDataString(Model.ContractPhase ?? "")&UbsAcNo=@Uri.EscapeDataString(Model.UbsAcNo ?? "")">
                                    Previous
                                </a>
                            }

                            @{
                                var lastDisplayedPage = 0;
                            }

                            @for (int pageNumber = 1;
                                  pageNumber <= Model.TotalPages;
                                  pageNumber++)
                            {
                                var displayPage =
                                    Model.TotalPages <= 7
                                    || pageNumber <= 3
                                    || pageNumber > Model.TotalPages - 3
                                    || Math.Abs(pageNumber - Model.PageIndex) <= 2;

                                if (!displayPage)
                                {
                                    continue;
                                }

                                if (lastDisplayedPage > 0 &&
                                    pageNumber > lastDisplayedPage + 1)
                                {
                                    <span class="ellipsis">...</span>
                                }

                                if (pageNumber == Model.PageIndex)
                                {
                                    <span class="current">@pageNumber</span>
                                }
                                else
                                {
                                    <a href="/Contract/NonInstallmentContract?PageIndex=@pageNumber&SearchSubmitted=true&BranchCode=@Uri.EscapeDataString(Model.BranchCode ?? "")&ContractCode=@Uri.EscapeDataString(Model.ContractCode ?? "")&FISubjectCode=@Uri.EscapeDataString(Model.FISubjectCode ?? "")&ContractPhase=@Uri.EscapeDataString(Model.ContractPhase ?? "")&UbsAcNo=@Uri.EscapeDataString(Model.UbsAcNo ?? "")">
                                        @pageNumber
                                    </a>
                                }

                                lastDisplayedPage = pageNumber;
                            }

                            @if (Model.PageIndex < Model.TotalPages)
                            {
                                <a href="/Contract/NonInstallmentContract?PageIndex=@(Model.PageIndex + 1)&SearchSubmitted=true&BranchCode=@Uri.EscapeDataString(Model.BranchCode ?? "")&ContractCode=@Uri.EscapeDataString(Model.ContractCode ?? "")&FISubjectCode=@Uri.EscapeDataString(Model.FISubjectCode ?? "")&ContractPhase=@Uri.EscapeDataString(Model.ContractPhase ?? "")&UbsAcNo=@Uri.EscapeDataString(Model.UbsAcNo ?? "")">
                                    Next
                                </a>
                            }

                        </div>
                    }
                }

                <br />

                <a href="/Contract/AddNonInstallmentContract"
                   class="btn-small">
                    Add
                </a>

                @if (Model.SearchSubmitted)
                {
                    <button class="btn-small"
                            data-noninstallment-refresh
                            type="button">
                        Refresh
                    </button>

                    <button type="submit"
                            class="btn-small"
                            id="deleteContractsButton">
                        Delete
                    </button>
                }

            </form>
        </fieldset>
    </div>

    @{
        var popupMessage = Model.DeleteMessage;
        var popupTitle = Model.DeleteMessageTitle;
        var popupType = Model.DeleteMessageType;

        if (string.IsNullOrWhiteSpace(popupMessage) &&
            !string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            popupMessage = Model.SuccessMessage;
            popupTitle = "Success";
            popupType = "success";
        }
    }

    @if (!string.IsNullOrWhiteSpace(popupMessage))
    {
        <div class="message-overlay"
             id="messageModal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="messageTitle"
             aria-describedby="messageBody">

            <div class="message-dialog">
                <div class="message-header @popupType">
                    <h3 id="messageTitle">@popupTitle</h3>

                    <button type="button"
                            class="message-close"
                            aria-label="Close">
                        &times;
                    </button>
                </div>

                <div class="message-body @popupType"
                     id="messageBody">
                    @popupMessage
                </div>

                <div class="message-footer">
                    <button type="button" class="message-ok">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="message-overlay"
         id="deleteConfirmModal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="deleteConfirmTitle"
         aria-describedby="deleteConfirmBody"
         style="display:none;">

        <div class="message-dialog">
            <div class="message-header warning">
                <h3 id="deleteConfirmTitle">Confirm Deletion</h3>
            </div>

            <div class="message-body warning"
                 id="deleteConfirmBody">
                Are you sure you want to delete the selected contract(s)?
            </div>

            <div class="message-footer">
                <button type="button"
                        class="message-button"
                        id="confirmDeleteButton">
                    Yes, Delete
                </button>

                <button type="button"
                        class="message-ok"
                        id="cancelDeleteButton">
                    Cancel
                </button>
            </div>
        </div>
    </div>

</div>
