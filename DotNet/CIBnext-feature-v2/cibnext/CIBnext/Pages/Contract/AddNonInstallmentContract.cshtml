@page
@model CIBnext.Pages.Contract.AddNonInstallmentContractModel
<style>
    .page-title {
        font-size: 28px;
        font-weight: bold;
        padding: 5px;
        border-bottom: 1px solid #999;
    }

    .section {
        border: 1px solid #b8b8a8;
        background: #edf4ef;
        padding: 10px;
        margin-top: 5px;
    }

    fieldset {
        border: 1px solid #b8b8a8;
        padding: 10px;
    }

    legend {
        padding: 0 5px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    td {
        padding: 4px;
        font-size: 13px;
    }

    .label-hint {
        color: #06c;
    }

    input, select {
        width: 220px;
        height: 22px;
    }

    .readonly-box {
        background: #eee;
    }

    .btn {
        padding: 4px 14px;
    }
</style>

<div class="page-title">Non-installment Contract</div>

@if (!string.IsNullOrEmpty(Model.ValidationMessage))
{
    <div style="color:red; font-weight:bold;">@Html.Raw(Model.ValidationMessage)</div>
}

<form method="post">
    <div class="section">
        <fieldset>
            <legend>General</legend>
            <table>
                <tr>
                    <td>Branch</td>
                    <td>
                        <select asp-for="Contract.BranchCode" asp-items="Model.BranchCodeList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>Borrower Name</td>
                    <td><input asp-for="Contract.BorrowerName" class="readonly-box" readonly /></td>
                </tr>

                <tr>
                    <td>F.I. Code</td>
                    <td><input value="046" class="readonly-box" readonly /></td>
                    <td></td>
                    <td></td>
                </tr>

                <tr>
                    <td class="label-hint">F.I. Subject Code</td>
                    <td>
                        <input asp-for="Contract.FISubjectCode" style="width:150px" />
                        <button type="submit" asp-page-handler="LookupBorrower" class="btn" style="width:auto">Find</button>
                        @if (!string.IsNullOrEmpty(Model.BorrowerLookupMessage))
                        {
                            <div style="color:red;">@Model.BorrowerLookupMessage</div>
                        }
                    </td>
                    <td>Starting Date of Contract</td>
                    <td><input asp-for="Contract.StartingDate" type="date" /></td>
                </tr>

                <tr>
                    <td class="label-hint">CBS A/C No.</td>
                    <td><input asp-for="Contract.UbsAccountNo" /></td>
                    <td>Request Date of Contract</td>
                    <td><input asp-for="Contract.RequestDate" type="date" /></td>
                </tr>

                <tr>
                    <td class="label-hint">F.I. Contract Code</td>
                    <td>
                        @if (Model.IsEdit)
                        {
                            <input asp-for="Contract.FIContractCode" readonly class="readonly-box" />
                        }
                        else
                        {
                            <input asp-for="Contract.FIContractCode" />
                        }
                    </td>
                    <td>Planned End Date of Contract</td>
                    <td><input asp-for="Contract.PlannedEndDate" type="date" /></td>
                </tr>

                <tr>
                    <td class="label-hint">Contract Type</td>
                    <td>
                        <select asp-for="Contract.ContractType" asp-items="Model.ContractTypeList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>Actual End Date of Contract</td>
                    <td><input asp-for="Contract.ActualEndDate" type="date" /></td>
                </tr>

                <tr>
                    <td class="label-hint">Contract Phase</td>
                    <td>
                        <select asp-for="Contract.ContractPhase" asp-items="Model.ContractPhaseList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>Date of Last Payment</td>
                    <td><input asp-for="Contract.DateOfLastPayment" type="date" /></td>
                </tr>

                <tr>
                    <td class="label-hint">Contract Status</td>
                    <td>
                        <select asp-for="Contract.ContractStatus" asp-items="Model.ContractStatusList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="SubsidizedCreditFlag" type="checkbox" style="width:auto" />
                        Subsidized Credit
                    </td>
                    <td></td>
                </tr>

                <tr>
                    <td class="label-hint">Currency Code</td>
                    <td>
                        <select asp-for="Contract.CurrencyCode" asp-items="Model.CurrencyList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="PreFinanceFlag" type="checkbox" style="width:auto" />
                        Pre-Finance of Loan
                    </td>
                    <td></td>
                </tr>

                <tr>
                    <td>Code Reorganized Credit</td>
                    <td>
                        <select asp-for="Contract.CodeReorganizedCredit" asp-items="Model.ReorganizedCreditList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>Amount Guaranteed by Third Party Guarantor</td>
                    <td><input asp-for="Contract.AmountGuaranteedByThirdParty" /></td>
                </tr>

                <tr>
                    <td>Third Party Guarantee Type</td>
                    <td>
                        <select asp-for="Contract.ThirdPartyGuaranteeType" asp-items="Model.ThirdPartyGuaranteeTypeList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>Amount Guaranteed by Security</td>
                    <td><input asp-for="Contract.AmountGuaranteedBySecurityType" /></td>
                </tr>

                <tr>
                    <td>Security Type</td>
                    <td>
                        <select asp-for="Contract.SecurityType" asp-items="Model.SecurityTypeList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="QualitativeJudgementFlag" type="checkbox" style="width:auto" />
                        Qualitative Judgement
                    </td>
                    <td></td>
                </tr>

                <tr>
                    <td class="label-hint">Defaulter Status</td>
                    <td>
                        <select asp-for="Contract.DefaulterStatus" asp-items="Model.DefaulterStatusList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            </table>
        </fieldset>
    </div>

    <div class="section">
        <fieldset>
            <legend>Non Installment Contract</legend>
            <table>
                <tr>
                    <td class="label-hint">Sanction Limit</td>
                    <td><input asp-for="Contract.SanctionLimit" /></td>
                    <td>No. of Days of Payment Delay</td>
                    <td>
                        <select asp-for="Contract.NumberOfDaysOfPaymentDelay" asp-items="Model.NoOfDaysPaymentDelayList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                </tr>

                <tr>
                    <td class="label-hint">Total Outstanding Amount</td>
                    <td><input asp-for="Contract.TotalOutstandingAmount" /></td>
                    <td>Date of Last Rescheduling</td>
                    <td><input asp-for="Contract.DateOfLastRescheduling" type="date" /></td>
                </tr>

                <tr>
                    <td>No. of Times Rescheduling</td>
                    <td><input asp-for="Contract.NumberOfTimesRescheduling" /></td>
                    <td>Cumulative Recovery</td>
                    <td><input asp-for="Contract.CumulativeRecovery" /></td>
                </tr>

                <tr>
                    <td>Recovery During Reporting Period</td>
                    <td><input asp-for="Contract.RecoveryDuringTheReportingPeriod" /></td>
                    <td>Due for recovery</td>
                    <td><input asp-for="Contract.DueForRecovery" /></td>
                </tr>

                <tr>
                    <td></td>
                    <td></td>
                    <td>Date of Law Suit</td>
                    <td><input asp-for="Contract.DateOfLawSuit" type="date" /></td>
                </tr>

                <tr>
                    <td>Economic Purpose Code</td>
                    <td>
                        <select asp-for="Contract.EconomicPurposeCode" asp-items="Model.EconomicPurposeCodeList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>Date of Classification</td>
                    <td><input asp-for="Contract.DateOfClassification" type="date" /></td>
                </tr>

                <tr>
                    <td>Enterprise Type</td>
                    <td>
                        <select asp-for="Contract.EnterpriseType" asp-items="Model.EnterpriseTypeList">
                            <option value="">--Select--</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="SmeFlag" type="checkbox" style="width:auto" />
                        SME
                    </td>
                    <td></td>
                </tr>
            </table>
        </fieldset>
    </div>

    <div class="section">
        <button type="submit" class="btn">Save</button>
        <a href="/Contract/NonInstallmentContract" class="btn">Exit</a>
    </div>
</form>