@page
@model CIBnext.Pages.Contract.InstallmentContractErrorListModel

@{
    ViewData["Title"] = "Installment Contract Error List";
}

<div class="personal-information-page">

    <div class="page-title">
        Installment Contract Error List
    </div>

    <div class="section">
        <fieldset>
            <legend>Search Option</legend>

            <form method="get">
                <table>
                    <tr>
                        <td>Branch Code:</td>
                        <td>
                            <input asp-for="BranchCode" />
                        </td>

                        <td>F.I. Subject Code:</td>
                        <td>
                            <input asp-for="FISubjectCode" />
                        </td>
                    </tr>

                    <tr>
                        <td>Contract Code:</td>
                        <td>
                            <input asp-for="ContractCode" />
                        </td>
                    </tr>
                </table>

                <button type="submit" class="btn-small">
                    Search
                </button>

                <a asp-page="/Contract/InstallmentContractErrorList"
                   class="btn-small">
                    Clear
                </a>

                <a asp-page="/Contract/InstallmentContract"
                   asp-route-BranchCode="@Model.BranchCode"
                   asp-route-ContractCode="@Model.ContractCode"
                   asp-route-FISubjectCode="@Model.FISubjectCode"
                   asp-route-ContractPhase="@Model.ContractPhase"
                   asp-route-UbsAcNo="@Model.UbsAcNo">
                    Back
                </a>
            </form>
        </fieldset>
    </div>

    <div class="section">
        <fieldset>
            <legend>Installment Contract Errors</legend>

            <h3>Total Count: @(Model.Errors?.Count ?? 0)</h3>

            <table>
                <thead>
                    <tr>
                        <th>Version No</th>
                        <th>Reporting Period</th>
                        <th>Contract Code</th>
                        <th>Primary Code</th>
                        <th>Primary Name</th>
                        <th>Error Code</th>
                        <th>Error Description</th>
                        <th>Make By</th>
                        <th>Make Date</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Errors != null && Model.Errors.Any())
                    {
                        @foreach (var error in Model.Errors)
                        {
                            <tr>
                                <td>@error.VersionNo</td>
                                <td>
                                    @(error.ReportingPeriod == default(DateTime)
                                        ? "-"
                                        : error.ReportingPeriod.ToString("dd-MMM-yyyy"))
                                </td>
                                <td>@error.FiContractCode</td>
                                <td>@error.FiPrimaryCode</td>
                                <td>@error.FiPrimaryName</td>
                                <td>@error.ErrorCode</td>
                                <td>@error.ErrorDescription</td>
                                <td>@error.MakeBy</td>
                                <td>
                                    @(error.MakeDate == default(DateTime)
                                        ? "-"
                                        : error.MakeDate.ToString("dd-MMM-yyyy"))
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="personal-information-empty">
                                No errors found for this contract.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </fieldset>
    </div>

</div>
