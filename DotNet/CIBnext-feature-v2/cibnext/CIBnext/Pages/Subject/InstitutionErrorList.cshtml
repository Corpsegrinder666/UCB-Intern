@page
@model CIBnext.Pages.Subject.InstitutionErrorListModel

<div class="personal-information-page">

    <div class="page-title">
        Institution Information Error List
    </div>

    <div class="section">
        <fieldset>
            <legend>Search Option</legend>

            <form method="get">
                <input type="hidden" name="SearchSubmitted" value="true" />
                <input type="hidden" name="PageNumber" value="1" />

                <table>
                    <tr>
                        <td>Branch Code:</td>
                        <td>
                            <select asp-for="BranchCode"
                                    asp-items="Model.BranchCodeList">
                                <option value="">All Branch</option>
                            </select>
                        </td>

                        <td>F.I. Subject Code:</td>
                        <td>
                            <input asp-for="SubjectCode" />
                        </td>

                        <td>Institution Name:</td>
                        <td>
                            <input asp-for="SubjectName" />
                        </td>
                    </tr>
                </table>

                <button type="submit" class="btn-small">
                    Search
                </button>

                <a asp-page="/Subject/InstitutionErrorList"
                   class="btn-small">
                    Clear
                </a>

                <a asp-page="/Subject/InstitutionInformation">
                    Back
                </a>
            </form>
        </fieldset>
    </div>

    @if (Model.SearchSubmitted)
    {
        <div class="section">
            <fieldset>
                <legend>Institution Information Errors</legend>

                <h3>Total Count: @Model.ErrorList.Count</h3>

                <table>
                    <thead>
                        <tr>
                            <th>Institution Code</th>
                            <th>Name</th>
                            <th>Error</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.ErrorList.Any())
                        {
                            @foreach (var item in Model.PagedErrorList)
                            {
                                <tr>
                                    <td>
                                        <a href="/Subject/AddInstitutionInformation?fiSubjectCode=@Uri.EscapeDataString(item.FiSubjectCode ?? string.Empty)">
                                            @item.FiSubjectCode
                                        </a>
                                    </td>

                                    <td>@item.FiSubjectName</td>

                                    <td>@item.ErrorDescription</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="personal-information-empty">
                                    No errors found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="pagination">
                    @{
                        var lastDisplayedPage = 0;
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        var displayPage = i <= 3
                            || i > Model.TotalPages - 3
                            || Math.Abs(i - Model.PageNumber) <= 2;

                        if (!displayPage)
                        {
                            continue;
                        }

                        if (lastDisplayedPage > 0 && i > lastDisplayedPage + 1)
                        {
                            <span class="ellipsis">...</span>
                        }

                        if (i == Model.PageNumber)
                        {
                            <span class="current">@i</span>
                        }
                        else
                        {
                            <a asp-page="/Subject/InstitutionErrorList"
                               asp-route-PageNumber="@i"
                               asp-route-SearchSubmitted="true"
                               asp-route-BranchCode="@Model.BranchCode"
                               asp-route-SubjectCode="@Model.SubjectCode"
                               asp-route-SubjectName="@Model.SubjectName">@i</a>
                        }

                        lastDisplayedPage = i;
                    }
                </div>

            </fieldset>
        </div>
    }

</div>
