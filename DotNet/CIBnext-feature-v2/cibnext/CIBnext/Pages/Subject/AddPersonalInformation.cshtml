@page
@model CIBnext.Pages.Subject.AddPersonalInformationModel

<style>
    body {
        font-family: Tahoma, sans-serif;
        font-size: 13px;
    }

    .title {
        font-size: 16px;
        font-weight: bold;
        padding: 8px;
        border-bottom: 1px solid #999;
        background: #f4f4ee;
    }

    fieldset {
        border: 1px solid #b5b5a5;
        margin-top: 5px;
        background: #edf4ef;
    }

    legend {
        font-size: 14px;
        padding: 0 5px;
    }

    table {
        width: 100%;
    }

    td {
        padding: 3px;
    }

    input, select {
        width: 180px;
        height: 22px;
        box-sizing: border-box;
    }

    .address-box {
        border: 1px solid #b5b5a5;
        padding: 5px;
        width: 32%;
        display: inline-block;
        vertical-align: top;
        box-sizing: border-box;
    }

        .address-box h4 {
            margin-top: 8px;
            margin-bottom: 8px;
        }

    .btn {
        display: inline-block;
        margin-top: 10px;
        padding: 7px 18px;
        border: 1px solid transparent;
        border-radius: 4px;
        font-family: Tahoma, sans-serif;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-save {
        background: #2e7d32;
        color: white;
    }

        .btn-save:hover {
            background: #1b5e20;
        }

    .btn-exit {
        background: #e5e7eb;
        color: #333;
        border-color: #bbb;
    }

        .btn-exit:hover {
            background: #d1d5db;
        }

    .auto-code {
        display: inline-block;
        width: 180px;
        height: 22px;
        line-height: 22px;
        padding: 0 3px;
        background: #eee;
        color: #666;
        border: 1px solid #999;
        box-sizing: border-box;
    }

    .label-hint {
        color: #06c;
    }

    .search-btn {
        width: 24px;
        height: 24px;
        vertical-align: middle;
        cursor: pointer;
    }

    .message-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.55);
        padding: 20px;
        box-sizing: border-box;
    }

    .message-dialog {
        background: #fff;
        width: 100%;
        max-width: 500px;
        border-radius: 8px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
        overflow: hidden;
        font-family: Tahoma, sans-serif;
    }

    .message-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
        background: #fbe9e7;
        border-bottom: 1px solid #efc7c3;
    }

        .message-header h3 {
            margin: 0;
            color: #b71c1c;
            font-size: 18px;
        }

    .message-close {
        border: none;
        background: transparent;
        color: #555;
        font-size: 26px;
        cursor: pointer;
        line-height: 1;
    }

    .message-body {
        padding: 20px;
        color: #c62828 !important;
        font-size: 14px;
        line-height: 1.8;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .message-footer {
        padding: 12px 20px;
        text-align: right;
        border-top: 1px solid #ddd;
        background: #fafafa;
    }

    .message-ok {
        padding: 8px 24px;
        background: #b71c1c;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

        .message-ok:hover {
            background: #8e0000;
        }

    @@media (max-width: 800px) {
        .address-box {
            width: 100%;
            margin-bottom: 8px;
        }

        table {
            display: block;
            overflow-x: auto;
        }
    }
</style>

<div class="title">
    @(Model.IsEdit ? "Edit" : "Add") Personal Information
</div>

<form method="post">
    @Html.AntiForgeryToken()

    @if (!string.IsNullOrWhiteSpace(Model.ValidationMessage))
    {
        <div id="validationModal"
             class="message-overlay"
             role="dialog"
             aria-modal="true"
             aria-labelledby="validationModalTitle">

            <div class="message-dialog">
                <div class="message-header">
                    <h3 id="validationModalTitle">Please Check</h3>

                    <button type="button"
                            class="message-close"
                            aria-label="Close message"
                            onclick="closeValidationModal()">
                        &times;
                    </button>
                </div>

                <div class="message-body">
                    @Model.ValidationMessage
                </div>

                <div class="message-footer">
                    <button type="button"
                            class="message-ok"
                            onclick="closeValidationModal()">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }

    <input asp-for="Subject.FISubjectCode" type="hidden" />

    <fieldset>
        <legend>General</legend>
        <table>
            <tr>
                <td>Branch</td>
                <td colspan="3">
                    <select asp-for="Subject.BranchCode"
                            style="width:450px"
                            asp-items="Model.BranchCodeList">
                        <option value="">--Select--</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>FI Subject Code</td>
                <td>
                    @if (Model.IsEdit)
                    {
                        <span class="auto-code">@Model.Subject.FISubjectCode</span>
                    }
                    else
                    {
                        <span class="auto-code">[AUTO]</span>
                    }
                </td>
                <td>Cif No</td>
                <td><input asp-for="Subject.CifNo" /></td>
            </tr>
            <tr>
                <td>Title</td>
                <td><input asp-for="Subject.Title" /></td>
                <td>Name</td>
                <td><input asp-for="Subject.Name" /></td>
            </tr>
            <tr>
                <td>Sector Type</td>
                <td>
                    <select asp-for="Subject.SectorType"
                            asp-items="Model.SectorTypeList">
                        <option value="">--Select--</option>
                    </select>
                </td>
                <td>Sector Code</td>
                <td>
                    <select asp-for="Subject.SectorCode"
                            asp-items="Model.SectorCodeList">
                        <option value="">--Select--</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>TIN (eTIN)</td>
                <td><input asp-for="Subject.TIN" /></td>
                <td>Phone Nr.</td>
                <td><input asp-for="Subject.PhoneNumber" /></td>
            </tr>
        </table>
    </fieldset>

    <fieldset>
        <legend>Personal</legend>
        <table>
            <tr>
                <td>Father's Title</td>
                <td><input asp-for="Subject.FathersTitle" /></td>
                <td class="label-hint">Father's Name</td>
                <td><input asp-for="Subject.FathersName" /></td>
                <td class="label-hint">Date of Birth</td>
                <td><input asp-for="Subject.DateOfBirth" type="date" /></td>
            </tr>
            <tr>
                <td>Mother's Title</td>
                <td><input asp-for="Subject.MothersTitle" /></td>
                <td class="label-hint">Mother's Name</td>
                <td><input asp-for="Subject.MothersName" /></td>
                <td class="label-hint">Country of Birth</td>
                <td>
                    <select asp-for="Subject.CountryOfBirth"
                            asp-items="Model.CountryList">
                        <option value="">--Select--</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>Spouse's Title</td>
                <td><input asp-for="Subject.SpousesTitle" /></td>
                <td>Spouse's Name</td>
                <td><input asp-for="Subject.SpousesName" /></td>
                <td class="label-hint">Place of Birth</td>
                <td><input asp-for="Subject.PlaceOfBirth" /></td>
            </tr>
            <tr>
                <td>Gender</td>
                <td>
                    <select asp-for="Subject.Gender"
                            asp-items="Model.GenderList">
                        <option value="">--Select--</option>
                    </select>
                </td>
                <td>National ID</td>
                <td><input asp-for="Subject.NationalIDNumber" /></td>
                <td>Smart ID</td>
                <td>
                    <input asp-for="Subject.SmartIDNumber"
                           style="width:150px" />
                    <button type="button"
                            class="search-btn"
                            title="Search by Smart ID"
                            aria-label="Search by Smart ID">
                        🔍
                    </button>
                </td>
            </tr>
        </table>

        <div class="address-box">
            <h4>Permanent Address</h4>
            Street<br />
            <input asp-for="Subject.PermanentAddress.Street" /><br />
            Postal Code<br />
            <input asp-for="Subject.PermanentAddress.PostalCode" /><br />
            District<br />
            <select asp-for="Subject.PermanentAddress.District"
                    asp-items="Model.DistrictList">
                <option value="">--Select--</option>
            </select><br />
            Country<br />
            <select asp-for="Subject.PermanentAddress.CountryCode"
                    asp-items="Model.CountryList">
                <option value="">--Select--</option>
            </select>
        </div>

        <div class="address-box">
            <h4>Present Address</h4>
            Street<br />
            <input asp-for="Subject.PresentAddress.Street" /><br />
            Postal Code<br />
            <input asp-for="Subject.PresentAddress.PostalCode" /><br />
            District<br />
            <select asp-for="Subject.PresentAddress.District"
                    asp-items="Model.DistrictList">
                <option value="">--Select--</option>
            </select><br />
            Country<br />
            <select asp-for="Subject.PresentAddress.CountryCode"
                    asp-items="Model.CountryList">
                <option value="">--Select--</option>
            </select>
        </div>

        <div class="address-box">
            <h4>Business Address</h4>
            Street<br />
            <input asp-for="Subject.BusinessAddress.Street" /><br />
            Postal Code<br />
            <input asp-for="Subject.BusinessAddress.PostalCode" /><br />
            District<br />
            <select asp-for="Subject.BusinessAddress.District"
                    asp-items="Model.DistrictList">
                <option value="">--Select--</option>
            </select><br />
            Country<br />
            <select asp-for="Subject.BusinessAddress.CountryCode"
                    asp-items="Model.CountryList">
                <option value="">--Select--</option>
            </select>
        </div>
    </fieldset>

    <fieldset>
        <legend>Other Document</legend>
        <table>
            <tr>
                <td>ID Type</td>
                <td>
                    <select asp-for="Subject.IDType"
                            asp-items="Model.IdTypeList">
                        <option value="">--Select--</option>
                    </select>
                </td>
                <td>ID Nr.</td>
                <td><input asp-for="Subject.IDNumber" /></td>
            </tr>
            <tr>
                <td>ID Issue Country</td>
                <td>
                    <select asp-for="Subject.IDIssueCountryCode"
                            asp-items="Model.CountryList">
                        <option value="">--Select--</option>
                    </select>
                </td>
                <td>ID Issue Date</td>
                <td><input asp-for="Subject.IDIssueDate" type="date" /></td>
            </tr>
        </table>
    </fieldset>

    <fieldset>
        <legend>Record Info</legend>
        <table>
            <tr>
                <td>Maker</td>
                <td>@Model.Subject.MakeBy</td>
            </tr>
            <tr>
                <td>Last Update Date</td>
                <td>
                    @(Model.Subject.MakeDate == default(DateTime)
                        ? ""
                        : Model.Subject.MakeDate.ToString("dd-MMM-yyyy"))
                </td>
            </tr>
            <tr>
                <td>Record Status</td>
                <td>@Model.Subject.RecordStatus</td>
            </tr>
        </table>
    </fieldset>

    <button type="submit" class="btn btn-save">
        Save
    </button>

    <a asp-page="/Subject/PersonalInformation"
       class="btn btn-exit">
        Exit
    </a>
</form>

<script>
    function closeValidationModal() {
        const modal = document.getElementById("validationModal");

        if (modal) {
            modal.style.display = "none";
        }
    }

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeValidationModal();
        }
    });
</script>
