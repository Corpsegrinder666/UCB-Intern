@page
@model CIBnext.Pages.Subject.PersonalInformationErrorListModel

<div class="personal-information-page">

    <div class="page-title">
        Personal Information Error List
    </div>

    <div class="section">
        <fieldset>
            <legend>Search Option</legend>

            <form method="get">
                <input type="hidden" name="SearchSubmitted" value="true" />

                <table>
                    <tr>
                        <td>Branch Code:</td>
                        <td>
                            <select asp-for="BranchCode"
                                    asp-items="Model.BranchCodeList">
                                <option value="">All Branch</option>
                            </select>
                        </td>

                        <td>F.I. Subject Code:</td>
                        <td>
                            <input asp-for="SubjectCode" />
                        </td>

                        <td>F.I. Subject Name:</td>
                        <td>
                            <input asp-for="SubjectName" />
                        </td>
                    </tr>
                </table>

                <button type="submit" class="btn-small">
                    Search
                </button>

                <a asp-page="/Subject/PersonalInformationErrorList"
                   class="btn-small">
                    Clear
                </a>

                <a asp-page="/Subject/PersonalInformation">
                    Back
                </a>
            </form>
        </fieldset>
    </div>

    @if (Model.SearchSubmitted)
    {
        <div class="section">
            <fieldset>
                <legend>Personal Information Errors</legend>

                <table>
                    <thead>
                        <tr>
                            <th>Subject Code</th>
                            <th>Name</th>
                            <th>Error</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.ErrorList.Any())
                        {
                            @foreach (var error in Model.PagedErrorList)
                            {
                                <tr>
                                    <td>
                                        <a asp-page="/Subject/AddPersonalInformation"
                                           asp-route-fiSubjectCode="@error.FiSubjectCode">
                                            @error.FiSubjectCode
                                        </a>
                                    </td>

                                    <td>@error.FiSubjectName</td>

                                    <td>@error.ErrorDescription</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="personal-information-empty">
                                    No error records found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.TotalPages > 1)
                {
                    <div class="personal-information-pagination">

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageNumber)
                            {
                                <strong>@i</strong>
                            }
                            else
                            {
                                <a asp-page="/Subject/PersonalInformationErrorList"
                                   asp-route-SearchSubmitted="true"
                                   asp-route-BranchCode="@Model.BranchCode"
                                   asp-route-SubjectCode="@Model.SubjectCode"
                                   asp-route-SubjectName="@Model.SubjectName"
                                   asp-route-PageNumber="@i">
                                    @i
                                </a>
                            }

                            @if (i < Model.TotalPages)
                            {
                                <text> </text>
                            }
                        }

                    </div>
                }
            </fieldset>
        </div>
    }

</div>
